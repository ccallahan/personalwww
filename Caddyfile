:{$PORT} {
    # Enable automatic HTTPS
    encode gzip

    # Reverse proxy to Reflex backend on port 8080
    reverse_proxy localhost:8080 {
        # WebSocket support
        header_up Host {host}
        header_up X-Real-IP {remote}
        header_up X-Forwarded-For {remote}
        header_up X-Forwarded-Proto {scheme}
    }
}
